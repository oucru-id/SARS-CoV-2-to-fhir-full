params {
    input           = "$baseDir/data/samplesheet.csv"
    reads_dir       = "$baseDir/data/NGS"
    vcf_dir         = "$baseDir/data/VCF"
    results_dir     = "$baseDir/results"
    reference       = "$baseDir/data/MN908947.3.fasta"
    gff             = "$baseDir/data/MN908947.3.gff"
    bowtie2_index   = "$baseDir/data/bowtie2_index"
    contig          = 'MN908947.3'
    primer_scheme_dir = "$baseDir/data/primer_schemes"
    primer_scheme     = 'artic_v3'      // default, per-sample override in samplesheet
    protocol          = 'amplicon'      // 'amplicon' or 'metagenomic'
    scheme_read_lengths = [
        artic_v3    : [300, 700],
        artic_v4_1  : [300, 700],
        artic_v5_3_2: [300, 700],
        neb_vss2    : [300, 700],
        neb_vsl1    : [1400, 2300],
        none        : [200, 3000]
    ]
    illumina_suffix   = '_illumina'
    nanopore_suffix   = '_ont'
    nanopore_min_q    = 10
    illumina_min_len  = 50
    skip_host_removal = false
    hostile_index     = 'human-t2t-hla'
    hostile_cache_dir = "$baseDir/data/hostile_index"
    variant_caller    = 'ivar'          // 'ivar' or 'bcftools'
    min_coverage      = 10
    min_allele_freq   = 0.25
    min_base_quality  = 20
    min_mapped_reads  = 1000
    medaka_model      = 'r941_prom_sup_variant_g507'
    consensus_caller  = 'bcftools'
    snpeff_db         = "$baseDir/data/snpeff_db"
    snpeff_config     = "$baseDir/data/snpEff.config"
    nextclade_dataset = "$baseDir/data/nextclade_db"
    skip_nextclade    = false
    pangolin_csv      = null
    skip_assembly       = false
    assembler           = 'megahit'
    skip_abacas         = false
    skip_quast          = false
    skip_markduplicates = true
    patient_metadata      = "$baseDir/data/patient_clinical_metadata.csv"
    organization_metadata = "$baseDir/data/organization_metadata.csv"
    practitioner_metadata = "$baseDir/data/practitioner_metadata.csv"
    fhir_validator           = "$baseDir/tools/fhir-validator.jar"
    fhir_reference_accession = 'NC_045512.2'
    fhir_server_url          = null
    api_key                  = null
    version    = '0.0.1'
    max_cpus   = 8
    max_memory = '10 GB'
    max_time   = '24h'
}

env {
    PATH = "${System.getenv('HOME')}/.cargo/bin:${System.getenv('HOME')}/medaka-env/bin:${System.getenv('PATH')}"
    HOSTILE_CACHE_DIR = "${params.hostile_cache_dir}"
}

process {
    cpus   = 2
    memory = '2 GB'

    withName: 'FASTQC.*'      { cpus = 4; memory = '4 GB' }
    withName: 'FASTP'         { cpus = 4; memory = '4 GB' }
    withName: 'CHOPPER'       { cpus = 4; memory = '4 GB' }
    withName: 'BOWTIE2'       { cpus = 6; memory = '4 GB' }
    withName: 'MINIMAP2'      { cpus = 6; memory = '4 GB' }
    withName: 'IVAR_TRIM'     { cpus = 2; memory = '2 GB' }
    withName: 'IVAR_VARIANTS' { cpus = 2; memory = '2 GB' }
    withName: 'MARK_DUPLICATES' { cpus = 2; memory = '4 GB' }
    withName: 'MEDAKA_INFERENCE' { cpus = 6; memory = '6 GB' }
    withName: 'SNPEFF'        { cpus = 2; memory = '4 GB' }
    withName: 'NEXTCLADE'     { cpus = 4; memory = '2 GB' }
    withName: 'MEGAHIT'       { cpus = 6; memory = '6 GB' }
    withName: 'QUAST'         { cpus = 2; memory = '2 GB' }
    withName: 'MULTIQC'       { cpus = 2; memory = '4 GB' }
    withName: 'VALIDATE_FHIR' { cpus = 2; memory = '4 GB' }
    withName: 'HOSTILE_LONG'  { cpus = 6; memory = '9 GB'; maxForks = 1 }
    withName: 'HOSTILE_SHORT' { cpus = 6; memory = '5 GB'; maxForks = 2 }
}

profiles {
    standard { process.executor = 'local' }
    hpc {
        process.executor = 'slurm'
        process.queue    = 'normal'
    }
    test {
        params.input    = "$baseDir/data/samplesheet_test.csv"
        params.max_cpus = 2
    }
}

docker      { enabled = false }
singularity { enabled = false }

report   { enabled = true; file = "$baseDir/results/runningstat/execution.html"; overwrite = true }
timeline { enabled = true; file = "$baseDir/results/runningstat/timeline.html";  overwrite = true }
dag      { enabled = true; file = "$baseDir/results/runningstat/dag.html";       overwrite = true }